# 本机私有配置（真实数据库口令等）——本文件已被 .gitignore 排除，勿提交。
# 使用方式：复制本文件为 application-local.yml 填真实值，
# 并在 application.yml 的 spring.profiles.active 中追加 local，或以 --spring.profiles.active=dev,local 启动。
spring:
  datasource:
    url: jdbc:mysql://<IP>:3306/hxzk?useUnicode=true&characterEncoding=utf8mb4&serverTimezone=Asia/Shanghai&useSSL=false&allowPublicKeyRetrieval=true
    username: <账号>
    password: <密码>
